@model (string Kind, string Size, string Label)
@{
    var kind = (Model.Kind ?? "Agent").Trim();
    var size = string.IsNullOrWhiteSpace(Model.Size) ? "md" : Model.Size.Trim().ToLowerInvariant();
    var sizeClass = size switch
    {
        "xs" => "i3d-xs",
        "sm" => "i3d-sm",
        "lg" => "i3d-lg",
        "xl" => "i3d-xl",
        _ => "i3d-md"
    };
    var uid = Guid.NewGuid().ToString("N")[..8];
    var normalized = kind.ToLowerInvariant();
    var defaultLabel = normalized switch
    {
        "agent" => "Agent 3D 神經核心立方體",
        "skill" => "Skill 3D 工作流棱鏡",
        "rule" => "Rule 3D 防禦盾牌",
        "command" => "Command 3D 終端機鍵帽",
        "success" => "同步成功 3D 綠寶石球體",
        "partialsuccess" => "部分成功 3D 琥珀警示錐",
        "running" => "同步執行中 3D 旋轉軌道環",
        "failed" => "同步失敗 3D 紅寶石斷裂盾",
        "lock" or "manuallyedited" => "人工鎖定 3D 金色鎖頭",
        "inactive" or "archived" => "已下架 3D 封存箱",
        "token" or "key" => "GitHub Token 3D 鑰匙",
        "llm" or "brain" => "LLM AI 3D 晶核大腦",
        "pulse" or "telemetry" => "系統遙測 3D 脈衝環",
        _ => $"{kind} 3D 圖示"
    };
    var titleText = string.IsNullOrWhiteSpace(Model.Label) ? defaultLabel : Model.Label;
    var extraAnim = normalized == "running" ? "i3d-spin-slow" : "";
}

<span class="i3d-stage" title="@titleText" aria-label="@titleText" role="img">
    <span class="i3d-icon @sizeClass @extraAnim">
        @switch (normalized)
        {
            case "agent":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="agTop-@uid" x1="12" y1="8" x2="52" y2="28" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#a5b4fc" />
                            <stop offset="100%" stop-color="#6366f1" />
                        </linearGradient>
                        <linearGradient id="agLeft-@uid" x1="10" y1="20" x2="32" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#4f46e5" />
                            <stop offset="100%" stop-color="#312e81" />
                        </linearGradient>
                        <linearGradient id="agRight-@uid" x1="32" y1="20" x2="54" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#818cf8" />
                            <stop offset="100%" stop-color="#4338ca" />
                        </linearGradient>
                    </defs>
                    <polygon points="32,6 54,18 32,30 10,18" fill="url(#agTop-@uid)" />
                    <polygon points="10,18 32,30 32,56 10,44" fill="url(#agLeft-@uid)" />
                    <polygon points="54,18 32,30 32,56 54,44" fill="url(#agRight-@uid)" />
                    <circle cx="32" cy="18" r="5" fill="#eef2ff" />
                    <path d="M32 30V43M21 24L32 30L43 24" stroke="#c7d2fe" stroke-width="2" stroke-linecap="round" />
                    <circle cx="32" cy="43" r="3" fill="#38bdf8" />
                </svg>
                break;

            case "skill":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="skTop-@uid" x1="14" y1="8" x2="50" y2="28" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#6ee7b7" />
                            <stop offset="100%" stop-color="#10b981" />
                        </linearGradient>
                        <linearGradient id="skLeft-@uid" x1="12" y1="20" x2="32" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#059669" />
                            <stop offset="100%" stop-color="#064e3b" />
                        </linearGradient>
                        <linearGradient id="skRight-@uid" x1="32" y1="20" x2="52" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#34d399" />
                            <stop offset="100%" stop-color="#047857" />
                        </linearGradient>
                    </defs>
                    <polygon points="32,7 52,19 32,31 12,19" fill="url(#skTop-@uid)" />
                    <polygon points="12,19 32,31 32,56 12,44" fill="url(#skLeft-@uid)" />
                    <polygon points="52,19 32,31 32,56 52,44" fill="url(#skRight-@uid)" />
                    <circle cx="32" cy="19" r="5.5" stroke="#ecfdf5" stroke-width="2.4" fill="none" />
                    <path d="M22 36L28 40L22 44M42 36L36 40L42 44" stroke="#a7f3d0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                break;

            case "rule":
            case "gate":
            case "guardrail":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="rlFace-@uid" x1="14" y1="8" x2="50" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#fde68a" />
                            <stop offset="50%" stop-color="#f59e0b" />
                            <stop offset="100%" stop-color="#b45309" />
                        </linearGradient>
                        <linearGradient id="rlSide-@uid" x1="32" y1="8" x2="52" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#d97706" />
                            <stop offset="100%" stop-color="#78350f" />
                        </linearGradient>
                    </defs>
                    <path d="M32 7L53 15V31C53 44 43 53 32 58C21 53 11 44 11 31V15L32 7Z" fill="url(#rlSide-@uid)" transform="translate(2,2)" opacity="0.55" />
                    <path d="M32 6L52 14V30C52 43 42 52 32 57C22 52 12 43 12 30V14L32 6Z" fill="url(#rlFace-@uid)" />
                    <path d="M32 10L48 16.5V30C48 40.5 40 48 32 52.5V10Z" fill="#ffffff" opacity="0.16" />
                    <path d="M24 31L30 37L41 24" stroke="#fffbeb" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                break;

            case "command":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="cmBase-@uid" x1="8" y1="22" x2="56" y2="54" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#0891b2" />
                            <stop offset="100%" stop-color="#164e63" />
                        </linearGradient>
                        <linearGradient id="cmTop-@uid" x1="12" y1="10" x2="52" y2="40" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#67e8f9" />
                            <stop offset="100%" stop-color="#06b6d4" />
                        </linearGradient>
                    </defs>
                    <rect x="8" y="18" width="48" height="36" rx="10" fill="url(#cmBase-@uid)" />
                    <rect x="12" y="11" width="40" height="33" rx="8" fill="url(#cmTop-@uid)" />
                    <path d="M22 23L28 28L22 33M31 33H41" stroke="#083344" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                break;

            case "success":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <radialGradient id="suc-@uid" cx="35%" cy="30%" r="65%">
                            <stop offset="0%" stop-color="#a7f3d0" />
                            <stop offset="45%" stop-color="#10b981" />
                            <stop offset="100%" stop-color="#065f46" />
                        </radialGradient>
                    </defs>
                    <circle cx="32" cy="32" r="24" fill="url(#suc-@uid)" />
                    <ellipse cx="24" cy="20" rx="8" ry="4" transform="rotate(-25 24 20)" fill="#ffffff" opacity="0.45" />
                    <path d="M22 33L29 40L43 25" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                break;

            case "partialsuccess":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="psL-@uid" x1="10" y1="10" x2="32" y2="54" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#fcd34d" />
                            <stop offset="100%" stop-color="#d97706" />
                        </linearGradient>
                        <linearGradient id="psR-@uid" x1="32" y1="10" x2="54" y2="54" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#f59e0b" />
                            <stop offset="100%" stop-color="#92400e" />
                        </linearGradient>
                    </defs>
                    <polygon points="32,8 8,52 32,56" fill="url(#psL-@uid)" />
                    <polygon points="32,8 56,52 32,56" fill="url(#psR-@uid)" />
                    <path d="M32 24V38" stroke="#fffbeb" stroke-width="4" stroke-linecap="round" />
                    <circle cx="32" cy="46" r="2.5" fill="#fffbeb" />
                </svg>
                break;

            case "running":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="22" stroke="#cbd5e1" stroke-width="5" />
                    <path d="M32 10A22 22 0 0 1 54 32" stroke="#4f46e5" stroke-width="5" stroke-linecap="round" />
                    <path d="M32 54A22 22 0 0 1 10 32" stroke="#06b6d4" stroke-width="5" stroke-linecap="round" />
                    <circle cx="32" cy="32" r="8" fill="#6366f1" />
                </svg>
                break;

            case "failed":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="fl-@uid" x1="12" y1="8" x2="52" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#fca5a5" />
                            <stop offset="50%" stop-color="#ef4444" />
                            <stop offset="100%" stop-color="#991b1b" />
                        </linearGradient>
                    </defs>
                    <polygon points="22,8 42,8 56,22 56,42 42,56 22,56 8,42 8,22" fill="url(#fl-@uid)" />
                    <path d="M23 23L41 41M41 23L23 41" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
                </svg>
                break;

            case "lock":
            case "manuallyedited":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="lk-@uid" x1="16" y1="26" x2="48" y2="56" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#fde68a" />
                            <stop offset="50%" stop-color="#f59e0b" />
                            <stop offset="100%" stop-color="#b45309" />
                        </linearGradient>
                    </defs>
                    <path d="M22 27V20C22 14.5 26.5 10 32 10C37.5 10 42 14.5 42 20V27" stroke="#d97706" stroke-width="5" stroke-linecap="round" />
                    <rect x="15" y="26" width="34" height="28" rx="7" fill="url(#lk-@uid)" />
                    <circle cx="32" cy="39" r="3.5" fill="#78350f" />
                    <path d="M32 42V47" stroke="#78350f" stroke-width="3" stroke-linecap="round" />
                </svg>
                break;

            case "inactive":
            case "archived":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,10 52,20 32,30 12,20" fill="#cbd5e1" />
                    <polygon points="12,20 32,30 32,54 12,44" fill="#94a3b8" />
                    <polygon points="52,20 32,30 32,54 52,44" fill="#64748b" />
                    <path d="M24 38L40 44" stroke="#f1f5f9" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                break;

            case "token":
            case "key":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ky-@uid" x1="10" y1="16" x2="54" y2="48" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#fde68a" />
                            <stop offset="55%" stop-color="#f59e0b" />
                            <stop offset="100%" stop-color="#b45309" />
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="32" r="13" fill="url(#ky-@uid)" />
                    <circle cx="22" cy="32" r="5" fill="#ffffff" />
                    <path d="M34 29H54V36H48V42H42V36H34V29Z" fill="url(#ky-@uid)" />
                </svg>
                break;

            case "llm":
            case "brain":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="br-@uid" x1="12" y1="12" x2="52" y2="52" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#c4b5fd" />
                            <stop offset="50%" stop-color="#7c3aed" />
                            <stop offset="100%" stop-color="#4c1d95" />
                        </linearGradient>
                    </defs>
                    <path d="M24 14C17 14 12 19 12 26C10 29 10 35 14 39C14 46 20 51 27 51H30V14H24Z" fill="url(#br-@uid)" />
                    <path d="M40 14C47 14 52 19 52 26C54 29 54 35 50 39C50 46 44 51 37 51H34V14H40Z" fill="#6366f1" />
                    <circle cx="23" cy="28" r="2.5" fill="#ecfeff" />
                    <circle cx="41" cy="28" r="2.5" fill="#ecfeff" />
                    <circle cx="32" cy="38" r="3" fill="#38bdf8" />
                </svg>
                break;

            case "sqlserver":
            case "sqlite":
            case "postgres":
            case "mysql":
            case "pg_db":
                var dbTop = normalized switch
                {
                    "sqlserver" => "#f87171",
                    "postgres" => "#60a5fa",
                    "mysql" => "#fbbf24",
                    "pg_db" => "#a78bfa",
                    _ => "#38bdf8"
                };
                var dbBody = normalized switch
                {
                    "sqlserver" => "#b91c1c",
                    "postgres" => "#1d4ed8",
                    "mysql" => "#d97706",
                    "pg_db" => "#6d28d9",
                    _ => "#0284c7"
                };
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 18V46C14 51 22 55 32 55C42 55 50 51 50 46V18H14Z" fill="@dbBody" />
                    <ellipse cx="32" cy="18" rx="18" ry="8" fill="@dbTop" />
                    <path d="M14 28C14 33 22 37 32 37C42 37 50 33 50 28" stroke="#ffffff" stroke-opacity="0.45" stroke-width="2" />
                    <path d="M14 38C14 43 22 47 32 47C42 47 50 43 50 38" stroke="#ffffff" stroke-opacity="0.35" stroke-width="2" />
                </svg>
                break;

            case "web":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="14" width="48" height="36" rx="7" fill="#312e81" transform="translate(3,3)" opacity="0.4" />
                    <rect x="8" y="12" width="48" height="36" rx="7" fill="#4f46e5" />
                    <rect x="10" y="21" width="44" height="25" rx="4" fill="#eef2ff" />
                    <circle cx="15" cy="16.5" r="1.8" fill="#fca5a5" />
                    <circle cx="20.5" cy="16.5" r="1.8" fill="#fde047" />
                    <circle cx="26" cy="16.5" r="1.8" fill="#86efac" />
                    <rect x="15" y="26" width="16" height="14" rx="3" fill="#818cf8" />
                    <rect x="34" y="26" width="15" height="6" rx="2" fill="#cbd5e1" />
                    <rect x="34" y="34" width="15" height="6" rx="2" fill="#cbd5e1" />
                </svg>
                break;

            case "mobile":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="19" y="8" width="28" height="48" rx="6" fill="#0f766e" transform="translate(3,2)" opacity="0.45" />
                    <rect x="18" y="7" width="28" height="48" rx="6" fill="#14b8a6" />
                    <rect x="21" y="13" width="22" height="34" rx="3" fill="#f0fdfa" />
                    <circle cx="32" cy="51" r="2" fill="#ccfbf1" />
                </svg>
                break;

            case "api":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="12" y="12" width="40" height="12" rx="4" fill="#0284c7" />
                    <rect x="12" y="27" width="40" height="12" rx="4" fill="#0369a1" />
                    <rect x="12" y="42" width="40" height="12" rx="4" fill="#0c4a6e" />
                    <circle cx="20" cy="18" r="2.2" fill="#34d399" />
                    <circle cx="20" cy="33" r="2.2" fill="#34d399" />
                    <circle cx="20" cy="48" r="2.2" fill="#38bdf8" />
                </svg>
                break;

            case "fullstack":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,8 52,18 32,28 12,18" fill="#818cf8" />
                    <polygon points="32,22 52,32 32,42 12,32" fill="#34d399" />
                    <polygon points="32,36 52,46 32,56 12,46" fill="#38bdf8" />
                </svg>
                break;

            case "game":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="10" y="18" width="44" height="28" rx="12" fill="#7c3aed" />
                    <path d="M22 26V38M16 32H28" stroke="#f5f3ff" stroke-width="3.5" stroke-linecap="round" />
                    <circle cx="41" cy="29" r="3" fill="#fbbf24" />
                    <circle cx="47" cy="35" r="3" fill="#34d399" />
                </svg>
                break;

            case "greenfield":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,8 52,19 32,30 12,19" fill="#6ee7b7" />
                    <polygon points="12,19 32,30 32,54 12,43" fill="#10b981" />
                    <polygon points="52,19 32,30 32,54 52,43" fill="#059669" />
                    <path d="M32 20V11M32 14C36 11 40 12 40 16C37 17 34 16 32 14Z" stroke="#ecfdf5" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                break;

            case "brownfield":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,8 52,19 32,30 12,19" fill="#fcd34d" />
                    <polygon points="12,19 32,30 32,54 12,43" fill="#d97706" />
                    <polygon points="52,19 32,30 32,54 52,43" fill="#b45309" />
                    <path d="M23 36L41 44M23 44L41 36" stroke="#fffbeb" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                break;

            case "compact":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,8 52,32 32,56 12,32" fill="#4f46e5" />
                    <polygon points="32,8 52,32 32,36" fill="#818cf8" />
                    <polygon points="32,8 12,32 32,36" fill="#6366f1" />
                </svg>
                break;

            case "comprehensive":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="10" y="10" width="19" height="19" rx="4" fill="#4f46e5" />
                    <rect x="35" y="10" width="19" height="19" rx="4" fill="#10b981" />
                    <rect x="10" y="35" width="19" height="19" rx="4" fill="#f59e0b" />
                    <rect x="35" y="35" width="19" height="19" rx="4" fill="#06b6d4" />
                </svg>
                break;

            case "bundle":
            case "zip":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,8 54,19 32,30 10,19" fill="#93c5fd" />
                    <polygon points="10,19 32,30 32,54 10,43" fill="#3b82f6" />
                    <polygon points="54,19 32,30 32,54 54,43" fill="#1d4ed8" />
                    <path d="M22 14L42 24" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
                </svg>
                break;

            case "playbook":
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="14" y="10" width="36" height="44" rx="6" fill="#334155" />
                    <rect x="18" y="14" width="28" height="36" rx="4" fill="#f8fafc" />
                    <path d="M24 23H40M24 31H40M24 39H34" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
                </svg>
                break;

            default:
                var tileFill = normalized switch
                {
                    "dotnet" => "#512bd4",
                    "kotlin" => "#7f52ff",
                    "react" => "#0ea5e9",
                    "vue" => "#10b981",
                    "python" => "#2563eb",
                    "go" => "#06b6d4",
                    "java" => "#ea580c",
                    "luau" => "#3b82f6",
                    "godot" => "#0284c7",
                    "cpp" => "#1d4ed8",
                    "sa" => "#4f46e5",
                    "sd" => "#0ea5e9",
                    "pg_fe" => "#10b981",
                    "pg_be" => "#6366f1",
                    "pg_test" => "#f59e0b",
                    "qa" => "#ef4444",
                    "mvc" => "#4f46e5",
                    "clean" => "#059669",
                    "mvvm" => "#0284c7",
                    "ecs" => "#7c3aed",
                    _ => "#475569"
                };
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="32,8 52,19 32,30 12,19" fill="@tileFill" fill-opacity="0.72" />
                    <polygon points="12,19 32,30 32,54 12,43" fill="@tileFill" />
                    <polygon points="52,19 32,30 32,54 52,43" fill="@tileFill" fill-opacity="0.86" />
                    <circle cx="32" cy="19" r="4" fill="#ffffff" fill-opacity="0.85" />
                </svg>
                break;
        }
    </span>
</span>
